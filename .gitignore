# Default-deny: only reviewed application paths are eligible for Git.
/*
!/.gitignore
!/.gitattributes
!/.env.development
!/README.md
!/패치 노트.txt
!/package.json
!/package-lock.json
!/jsconfig.json
!/components.json
!/tailwind.config.js
!/postcss.config.js
!/설치.bat
!/실행.bat
!/처음 실행.txt
!/src/
!/public/
!/manual/
!/iRacing_Backend/
!/scripts/
!/releases/
!/.githooks/
/iRacing_Backend/*
!/iRacing_Backend/*.py
!/iRacing_Backend/requirements*.txt
/scripts/*
!/scripts/launch_app.py
!/scripts/install_ui.py
!/scripts/test_install_ui.py
!/scripts/make_voice_pack.py
!/scripts/test_make_voice_pack.py
!/scripts/serve_ui.py
!/scripts/prepare_radio_audio.py
!/scripts/test_launch_app.py
!/scripts/make_share_copy.py
!/scripts/make_patch.py
!/scripts/read_coach_log.py
!/scripts/read_timing_log.py
!/scripts/find_python.bat
!/scripts/overlay_sample.py
!/scripts/overlay_trace.py
!/scripts/overlay_celebration.py
!/scripts/overlay_demo_data.py
!/scripts/overlay_native.py
!/scripts/overlay_theme.py
!/scripts/overlay_rendering.py
!/scripts/overlay_commands.py
!/scripts/test_make_patch.py
!/scripts/audit_git.py
!/scripts/test_audit_git.py
/releases/*
!/releases/[0-9]*.json
!/releases/voice-[0-9]*.json

# Never commit credentials, recordings, telemetry, caches or local settings.
**/node_modules/
**/__pycache__/
**/.venv/
**/.pytest_cache/
**/gcp-key.json
**/garage61_api_token.txt
**/credentials.json
**/token.json
**/settings.json
**/data-location.txt*
**/log-upload-url.txt
*.mp3
*.wav
*.ogg
*.m4a
*.flac
*.ibt
*.sqlite*
*.db
*.pem
*.key
*.p12
*.pfx
*.zip
*.log
*.pyc
.env*
!/.env.development
